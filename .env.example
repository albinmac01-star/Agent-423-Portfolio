# ========================================================
# AI TRADING SYSTEM — ENVIRONMENT VARIABLES
# Copy to .env and fill in real values. Never commit .env.
# ========================================================

# --- Anthropic ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-5

# --- OpenRouter ---
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- AI Analysts (Custom Waterfall) ---
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- Queue (choose one provider) ---
QUEUE_PROVIDER=supabase          # options: supabase | sqs

# --- Supabase (recommended for v1) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_TABLE=signals

# --- AWS SQS (alternative) ---
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/trading-signals
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# --- Google Sheets ---
SHEETS_SPREADSHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# --- MetaTrader 5 ---
MT5_LOGIN=your_mt5_account_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=MetaQuotes-Demo

# --- Risk Controls ---
LIVE_TRADING=False               # Set True only after 20-30 paper signals validated
RISK_PCT_PER_TRADE=1.0           # 1% account risk per trade