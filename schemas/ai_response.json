{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClaudeDecisionResponse",
  "description": "Strict output schema from Claude. Decision: EXECUTE or HOLD only. Claude never specifies lot size or broker parameters.",
  "type": "object",
  "required": ["decision", "confidence", "reason", "ttl_seconds"],
  "properties": {
    "decision":    { "type": "string", "enum": ["EXECUTE", "HOLD"] },
    "direction":   { "type": "string", "enum": ["BUY", "SELL"] },
    "confidence":  { "type": "number", "minimum": 0, "maximum": 1 },
    "reason":      { "type": "string", "maxLength": 500 },
    "ttl_seconds": { "type": "integer", "minimum": 10, "maximum": 600 }
  },
  "if": { "properties": { "decision": { "const": "EXECUTE" } } },
  "then": { "required": ["direction"] },
  "additionalProperties": false
}
